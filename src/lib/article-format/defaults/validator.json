{
  "schemaVersion": 1,
  "meta": {
    "id": "wechat-official"
  },
  "product": {
    "theme": {
      "tokens": [
        "color-article-ink",
        "color-article-heading",
        "color-article-muted",
        "color-article-quote-surface",
        "color-article-line",
        "color-article-accent",
        "color-article-link",
        "color-article-tint",
        "color-article-code",
        "color-article-code-surface",
        "color-article-code-tint"
      ],
      "cssProperties": [
        "accent-color",
        "background",
        "background-color",
        "border",
        "border-bottom",
        "border-bottom-color",
        "border-bottom-style",
        "border-bottom-width",
        "border-collapse",
        "border-color",
        "border-left",
        "border-left-color",
        "border-left-style",
        "border-left-width",
        "border-radius",
        "border-style",
        "border-top",
        "border-width",
        "color",
        "display",
        "font-family",
        "font-size",
        "font-style",
        "font-weight",
        "height",
        "letter-spacing",
        "line-height",
        "list-style",
        "list-style-position",
        "list-style-type",
        "margin",
        "margin-block",
        "margin-bottom",
        "margin-inline",
        "margin-left",
        "margin-right",
        "margin-top",
        "max-height",
        "max-width",
        "min-width",
        "overflow-wrap",
        "overflow-x",
        "padding",
        "padding-bottom",
        "padding-left",
        "padding-right",
        "padding-top",
        "text-align",
        "text-decoration",
        "text-indent",
        "text-transform",
        "text-underline-offset",
        "vertical-align",
        "white-space",
        "width",
        "word-break"
      ],
      "nodes": {
        "h1": [
          "h1"
        ],
        "h2": [
          "h2"
        ],
        "h3": [
          "h3"
        ],
        "h4": [
          "h4"
        ],
        "h5": [
          "h5"
        ],
        "h6": [
          "h6"
        ],
        "paragraph": [
          "p"
        ],
        "blockquote": [
          "blockquote"
        ],
        "inlineCode": [
          "code:not(pre code)"
        ],
        "codeBlock": [
          "pre"
        ],
        "table": [
          "table",
          "th",
          "td"
        ],
        "caption": [
          "figcaption"
        ],
        "divider": [
          "hr"
        ]
      },
      "nodeProperties": {
        "fontSize": "font-size",
        "lineHeight": "line-height",
        "color": "color"
      },
      "wrapperProperties": [
        "*"
      ],
      "allowUnknownCssProperties": true,
      "allowedDisplayValues": [],
      "limits": {
        "id": 48,
        "name": 80,
        "value": 180,
        "css": 20000,
        "json": 60000
      },
      "formatVersion": 1,
      "kind": "article-theme",
      "idPattern": "^[a-z0-9][a-z0-9-]{0,47}$",
      "versionPattern": "^\\d+(?:\\.\\d+){0,2}$",
      "valuePattern": "^[\\p{L}\\p{N}\\s#%.,/\\x27\"()_+*!:-]+$"
    }
  },
  "rules": [
    {
      "id": "opacity",
      "operator": "dom.opacity-overlay",
      "enabled": true,
      "stages": [
        "rendered"
      ],
      "parameters": {
        "property": "opacity",
        "value": 0,
        "overlaySelector": "svg"
      }
    },
    {
      "id": "caret-color",
      "operator": "style.transparent",
      "enabled": true,
      "stages": [
        "authoring",
        "rendered"
      ],
      "parameters": {
        "property": "caret-color"
      }
    },
    {
      "id": "line-height",
      "operator": "dom.text-overlap",
      "enabled": true,
      "stages": [
        "rendered"
      ],
      "parameters": {
        "property": "line-height",
        "singleLineExempt": true,
        "imageOnlyExempt": true,
        "sameLineOverlap": 0.5,
        "inkHeightFactor": 0.95
      }
    },
    {
      "id": "width",
      "operator": "dom.responsive-width",
      "enabled": true,
      "stages": [
        "rendered"
      ],
      "parameters": {
        "widths": [
          585,
          677,
          375
        ],
        "ignoreAttribute": "data-ignore-width",
        "widthDifference": 10,
        "ratioDifference": 0.2,
        "overflowTolerance": 1,
        "imageLoadTimeoutMs": 5000,
        "responsiveFillTolerance": 0.1,
        "constrainMaxWidth": true,
        "excludeCenteredOverflow": true,
        "candidateSelector": "img:not(.ProseMirror-separator), table thead th",
        "paragraphSelector": ".article-body > *",
        "dimensionProperty": "width",
        "ignoredWidthValues": [
          "auto",
          "100%"
        ],
        "exemptElements": [
          "svg"
        ]
      }
    },
    {
      "id": "height",
      "operator": "dom.height-overflow",
      "enabled": true,
      "stages": [
        "rendered"
      ],
      "parameters": {
        "property": "height",
        "zero": 0,
        "svgExempt": true,
        "imageOnlyExempt": true,
        "scrollExempt": true,
        "ignoreSelector": "[data-role=\"absolute-layout\"][data-mode=\"svg\"]"
      }
    },
    {
      "id": "text-align",
      "operator": "style.values",
      "enabled": true,
      "stages": [
        "authoring",
        "rendered"
      ],
      "parameters": {
        "property": "text-align",
        "values": [
          "start",
          "end"
        ]
      }
    },
    {
      "id": "animate-begin",
      "operator": "dom.animation-begin",
      "enabled": true,
      "stages": [
        "rendered"
      ],
      "parameters": {
        "selector": "animate[begin]",
        "touch": "touchstart",
        "click": "click"
      }
    },
    {
      "id": "pre",
      "operator": "dom.pre-text",
      "enabled": true,
      "stages": [
        "rendered"
      ],
      "parameters": {
        "selector": "pre",
        "codeExempt": true
      }
    },
    {
      "id": "nesting",
      "operator": "dom.redundant-nesting",
      "enabled": true,
      "stages": [
        "rendered"
      ],
      "parameters": {
        "limit": 10,
        "mediaExempt": [
          "img",
          "video",
          "svg"
        ]
      }
    },
    {
      "id": "span-leaf",
      "operator": "dom.leaf-content",
      "enabled": true,
      "stages": [
        "authoring",
        "rendered"
      ],
      "parameters": {
        "selector": "span[leaf]",
        "blockElements": [
          "section",
          "div",
          "p",
          "article",
          "aside",
          "header",
          "footer",
          "main",
          "blockquote",
          "pre",
          "ul",
          "ol",
          "li",
          "table",
          "h1",
          "h2",
          "h3",
          "h4",
          "h5",
          "h6"
        ]
      }
    },
    {
      "id": "node-leaf",
      "operator": "dom.nodeleaf-content",
      "enabled": true,
      "stages": [
        "authoring",
        "rendered"
      ],
      "parameters": {
        "selector": "section[nodeleaf]",
        "allowedElements": [
          "img"
        ],
        "disallowedElements": [
          "section",
          "div",
          "p",
          "span",
          "table",
          "ul",
          "ol",
          "li",
          "h1",
          "h2",
          "h3",
          "h4",
          "h5",
          "h6"
        ],
        "unknownComponents": "review"
      }
    },
    {
      "id": "font-family",
      "operator": "style.present",
      "enabled": true,
      "stages": [
        "authoring",
        "rendered"
      ],
      "parameters": {
        "property": "font-family"
      }
    },
    {
      "id": "dark-contrast",
      "operator": "official.dark-contrast",
      "enabled": true,
      "stages": [
        "rendered"
      ],
      "parameters": {
        "minimum": 1.5,
        "ignoreAttribute": "data-ignore-dm",
        "ignoreValue": "low-contrast"
      }
    },
    {
      "id": "dark-gradient",
      "operator": "official.dark-gradient",
      "enabled": true,
      "stages": [
        "rendered"
      ],
      "parameters": {
        "ignoreAttribute": "data-ignore-dm",
        "ignoreValue": "text-bg-gradient"
      }
    },
    {
      "id": "important",
      "operator": "style.important",
      "enabled": true,
      "stages": [
        "authoring",
        "rendered"
      ],
      "parameters": {}
    }
  ]
}
